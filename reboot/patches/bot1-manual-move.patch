+        void MoveToPlayer(UNetDriver* Driver, UObject* World)
+        {
+            Stage = "BOT1 validate movement infrastructure";
+            auto Controller = Resolve(LastBot.Controller);
+            auto Pawn = Resolve(LastBot.Pawn);
+            DetailedObject("BotController", Controller);
+            DetailedObject("BotPawn", Pawn);
+            if (!IsOf(Controller, L"/Script/AIModule.AIController"))
+            { LOG_INFO(LogBots, "[BOT][FAIL] BOT1-D AIController invalid/inadequate"); return; }
+            if (!IsOf(Pawn, L"/Script/FortniteGame.FortPlayerPawnAthena"))
+            { LOG_INFO(LogBots, "[BOT][FAIL] saved bot Pawn invalid/stale"); return; }
+            if (Reference(Controller, "Pawn") != Pawn || Reference(Pawn, "Controller") != Controller)
+            { LOG_INFO(LogBots, "[BOT][FAIL] BOT1-E possession mismatch"); return; }
+            auto Component = Movement(Pawn);
+            auto PathComponent = PathFollowing(Controller);
+            auto Navigation = Reference(World, "NavigationSystem");
+            ComponentState("MovementComponent", Component);
+            ComponentState("PathFollowingComponent", PathComponent);
+            DetailedObject("NavigationSystem", Navigation);
+            if (!IsOf(Component, L"/Script/Engine.PawnMovementComponent"))
+            { LOG_INFO(LogBots, "[BOT][FAIL] movement component missing/inadequate; not forcing movement mode"); return; }
+            if (!IsOf(PathComponent, L"/Script/AIModule.PathFollowingComponent"))
+            { LOG_INFO(LogBots, "[BOT][FAIL] BOT1-C path following component missing/inadequate"); return; }
+            if (!IsOf(Navigation, L"/Script/NavigationSystem.NavigationSystemV1"))
+            { LOG_INFO(LogBots, "[BOT][FAIL] BOT1-F NavigationSystem missing/inadequate; no initialization workaround"); return; }
+            auto Human = MoveTarget(Driver);
+            DetailedObject("Target player Pawn", Human);
+            if (!Valid(Human)) { LOG_INFO(LogBots, "[BOT][FAIL] human client Pawn not found (requires non-bot PlayerState)"); return; }
+            FVector Location{}, Target{};
+            if (!Getter(Pawn, L"/Script/Engine.Actor.K2_GetActorLocation", Location)
+                || !Getter(Human, L"/Script/Engine.Actor.K2_GetActorLocation", Target) || !Finite(Location) || !Finite(Target))
+            { LOG_INFO(LogBots, "[BOT][FAIL] current/target location unavailable/non-finite"); return; }
+            constexpr float Radius = 400.f;
+            const double Separation = Distance(Location, Target);
+            LOG_INFO(LogBots, "[BOT] CurrentLocation=({},{},{}) TargetLocation=({},{},{}) Distance={} AcceptanceRadius={}",
+                Location.X, Location.Y, Location.Z, Target.X, Target.Y, Target.Z, Separation, Radius);
+            if (Separation <= Radius)
+            { LOG_INFO(LogBots, "[BOT] already within acceptance radius; no move needed (not failure)"); return; }
+            Stage = "BOT1 resolve native MoveToLocation signature";
+            auto Fn = FindObject<UFunction>(L"/Script/AIModule.AIController.MoveToLocation");
+            ReflectedCall Call;
+            UObject* FilterClass = nullptr; // Native default navigation filter, no custom asset.
+            if (!Call.Init(Fn, {"Dest", "AcceptanceRadius", "bStopOnOverlap", "bUsePathfinding",
+                "bProjectDestinationToNavigation", "bCanStrafe", "FilterClass", "bAllowPartialPath", "ReturnValue"}, true)
+                || !Call.Put("Dest", Target) || !Call.Put("AcceptanceRadius", Radius)
+                || !Call.Put("bStopOnOverlap", false) || !Call.Put("bUsePathfinding", true)
+                || !Call.Put("bProjectDestinationToNavigation", true) || !Call.Put("bCanStrafe", false)
+                || !Call.Put("FilterClass", FilterClass) || !Call.Put("bAllowPartialPath", false)
+                || !Call.Put("ReturnValue", uint8_t{255}))
+            { LOG_INFO(LogBots, "[BOT][FAIL] MoveToLocation reflected signature unavailable/incompatible; no alternate call"); return; }
+            auto ResultEnum = FindObject<UEnum>(L"/Script/AIModule.EPathFollowingRequestResult");
+            if (!Valid(ResultEnum)) { LOG_INFO(LogBots, "[BOT][FAIL] move result enum unavailable"); return; }
+            const auto Failed = ResultEnum->GetValue("Failed");
+            const auto AtGoal = ResultEnum->GetValue("AlreadyAtGoal");
+            const auto Accepted = ResultEnum->GetValue("RequestSuccessful");
+            if (Failed < 0 || AtGoal < 0 || Accepted < 0 || Failed > 255 || AtGoal > 255 || Accepted > 255
+                || Failed == AtGoal || AtGoal == Accepted || Failed == Accepted)
+            { LOG_INFO(LogBots, "[BOT][FAIL] move result enum incompatible"); return; }
+            Stage = "BOT1 native AIController.MoveToLocation";
+            LOG_INFO(LogBots, "[BOT] Move request submitted function={} use_pathfinding=true project_to_nav=true stop_on_overlap=false can_strafe=false allow_partial=false FilterClass=null", Fn->GetFullName());
+            Call.Invoke(Controller); // Exactly one request for this explicit click, no follow loop.
+            uint8_t Result = 255;
+            Call.Return(Result);
+            const char* Name = Result == Failed ? "Failed" : Result == AtGoal ? "AlreadyAtGoal" : Result == Accepted ? "RequestSuccessful" : "Unknown";
+            LOG_INFO(LogBots, "[BOT] Move result={} name={}", Result, Name);
+            if (Result == Failed) { LOG_INFO(LogBots, "[BOT][FAIL] BOT1-C native request failed immediately; no retry"); }
+            if (Result == Accepted)
+            {
+                Observation = {true, GetTickCount64(), 1, Location, Target};
+                SampleMove(Pawn, Controller, 0);
+            }
+        }
+
+        void ProcessDebugBody(UNetDriver* Driver)
+        {
+            if (!StaticFindObjectOriginal || !Valid(Driver)) return;
+            auto World = Reference(Driver, "World");
+            if (!Valid(World) || Reference(World, "NetDriver") != Driver) return;
+            auto Action = PendingDebug.exchange(DebugAction::None);
+            if (Action == DebugAction::None && !Observation.Active) return;
+            Stage = "BOT1 validate saved world";
+            ContextWorld = World;
+            ContextMode = Reference(World, "AuthorityGameMode");
+            ContextState = Reference(World, "GameState");
+            ContextManager = Resolve(LastBot.Manager);
+            if (Resolve(LastBot.World) != World || Resolve(LastBot.GameState) != ContextState)
+            {
+                LOG_INFO(LogBots, "[BOT][FAIL] no saved bot in current world, or world/GameState changed; references discarded");
+                LastBot = {};
+                Observation.Active = false;
+                return;
+            }
+            if (Action == DebugAction::Dump) DumpState(World);
+            if (Action == DebugAction::Move)
+            {
+                Observation.Active = false;
+                EAthenaGamePhase Phase = EAthenaGamePhase::None;
+                if (Engine_Version != 426 || std::abs(Fortnite_Version - 13.40) > 0.001 || !Globals::bStartedListening
+                    || World->GetName() != "Apollo_Terrain" || !IsOf(ContextMode, L"/Script/FortniteGame.FortGameModeAthena")
+                    || !IsOf(ContextState, L"/Script/FortniteGame.FortGameStateAthena")
+                    || !Read(ContextState, "GamePhase", Phase) || Phase != EAthenaGamePhase::SafeZones)
+                { LOG_INFO(LogBots, "[BOT][FAIL] Move requires listening 13.40 Apollo Athena SafeZones; phase={}", static_cast<int>(Phase)); return; }
+                MoveToPlayer(Driver, World);
+            }
+            if (Observation.Active)
+            {
+                auto Pawn = Resolve(LastBot.Pawn);
+                auto Controller = Resolve(LastBot.Controller);
+                if (!Valid(Pawn) || !Valid(Controller) || Reference(Controller, "Pawn") != Pawn || Reference(Pawn, "Controller") != Controller)
+                { LOG_INFO(LogBots, "[BOT][FAIL] observation stopped: bot invalid or possession changed"); Observation.Active = false; return; }
+                const ULONGLONG Elapsed = GetTickCount64() - Observation.Started;
+                if (Elapsed > 5500)
+                {
+                    LOG_INFO(LogBots, "[BOT] observation window expired before next tick; no late sample/follow/retry");
+                    Observation.Active = false;
