+            LOG_INFO(LogBots, "[BOT] observation elapsed_ms={} location_available={} location=({},{},{}) velocity_available={} velocity=({},{},{}) move_status_available={} move_status={} status_name={} displacement={} distance_to_snapshot={}",
+                Elapsed, HasLocation, Location.X, Location.Y, Location.Z, HasVelocity, Velocity.X, Velocity.Y, Velocity.Z,
+                HasStatus, Status, HasStatus ? MoveStatusName(Status) : "unavailable",
+                HasLocation && Finite(Location) ? Distance(Location, Observation.InitialLocation) : -1.0,
+                HasLocation && Finite(Location) ? Distance(Location, Observation.TargetLocation) : -1.0);
+        }
