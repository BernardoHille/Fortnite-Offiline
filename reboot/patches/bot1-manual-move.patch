+        bool Finite(const FVector& V) { return std::isfinite(V.X) && std::isfinite(V.Y) && std::isfinite(V.Z); }
+        double Distance(const FVector& A, const FVector& B)
+        {
+            const double X = A.X - B.X, Y = A.Y - B.Y, Z = A.Z - B.Z;
+            return std::sqrt(X * X + Y * Y + Z * Z);
+        }
+
+        void SampleMove(UObject* Pawn, UObject* Controller, ULONGLONG Elapsed)
+        {
+            Stage = "BOT1 bounded movement observation";
+            FVector Location{}, Velocity{};
+            const bool HasLocation = Getter(Pawn, L"/Script/Engine.Actor.K2_GetActorLocation", Location);
+            const bool HasVelocity = Getter(Pawn, L"/Script/Engine.Actor.GetVelocity", Velocity);
+            uint8_t Status = 255;
