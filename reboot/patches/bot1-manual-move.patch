+        AFortPlayerPawnAthena* MoveTarget(UNetDriver* Driver)
+        {
+            if (Driver->GetOffset("ClientConnections", false) < 0) return nullptr;
+            const auto& Connections = Driver->GetClientConnections();
+            if (Connections.ArrayNum <= 0 || Connections.ArrayNum > 1000 || Connections.ArrayNum > Connections.ArrayMax
+                || !Connections.Data || IsBadReadPtr(Connections.Data, sizeof(UNetConnection*) * Connections.ArrayNum)) return nullptr;
+            for (int i = 0; i < Connections.ArrayNum; ++i)
+            {
+                auto Controller = Reference(Connections.at(i), "PlayerController");
+                if (!IsOf(Controller, L"/Script/FortniteGame.FortPlayerControllerAthena")) continue;
+                auto State = Reference(Controller, "PlayerState");
+                if (!IsOf(State, L"/Script/Engine.PlayerState") || State->GetOffset("bIsABot", false) < 0
+                    || reinterpret_cast<APlayerState*>(State)->IsBot()) continue;
+                auto Pawn = Reference(Controller, "Pawn");
+                if (Pawn != Resolve(LastBot.Pawn) && IsOf(Pawn, L"/Script/FortniteGame.FortPlayerPawnAthena"))
+                    return reinterpret_cast<AFortPlayerPawnAthena*>(Pawn);
+            }
+            return nullptr;
+        }
