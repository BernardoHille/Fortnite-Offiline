+        UObject* Resolve(const DebugReference& Ref)
+        {
+            if (!Ref.Expected || Ref.Weak.ObjectIndex < 0) return nullptr;
+            auto Item = GetItemByIndex(Ref.Weak.ObjectIndex);
+            if (!Item || IsBadReadPtr(Item, sizeof(FUObjectItem)) || Item->Object != Ref.Expected
+                || Item->SerialNumber != Ref.Weak.ObjectSerialNumber || !Valid(Item->Object)) return nullptr;
+            const auto Name = Item->Object->GetFName();
+            // The upstream FName equality ignores Number; compare it explicitly.
+            return Name.ComparisonIndex.Value == Ref.Name.ComparisonIndex.Value && Name.Number == Ref.Name.Number
+                ? Item->Object : nullptr;
+        }
