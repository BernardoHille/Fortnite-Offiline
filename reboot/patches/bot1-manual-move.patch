+        // Use the baseline's function reflection, not a guessed C++ params struct.
+        // Only exact native parameter sets are accepted; all offsets/sizes come from UFunction.
+        class ReflectedCall
+        {
+            UFunction* Function = nullptr;
+            std::vector<uint8_t> Bytes;
+            std::vector<std::pair<int, int>> Occupied;
+            bool LogParameters = false;
+        public:
+            bool Init(UFunction* Fn, std::initializer_list<const char*> Expected, bool TraceParameters = false)
+            {
+                if (!Valid(Fn) || !UObject::ProcessEventOriginal) return false;
+                const int Size = Fn->GetPropertiesSize();
+                if (Size <= 0 || Size > 512) return false;
+                auto Field = Fn->Get<void*>(Offsets::Children);
+                size_t Count = 0;
+                while (Field && Count <= Expected.size())
+                {
+                    if (IsBadReadPtr(Field, Offsets::Offset_Internal + sizeof(int))) return false;
+                    const auto Name = GetFNameOfProp(Field)->ToString();
+                    bool Known = false;
+                    for (const char* Member : Expected) if (Name == Member) Known = true;
+                    if (!Known) return false;
+                    ++Count;
+                    Field = GetNext(Field);
+                }
+                if (Field || Count != Expected.size()) return false;
+                for (const char* Member : Expected) if (Fn->GetOffsetFunc(Member, false) < 0) return false;
+                Function = Fn;
+                LogParameters = TraceParameters;
+                Bytes.assign(Size, 0);
+                return true;
+            }
+
+            template<typename T>
+            bool Put(const char* Member, const T& Value)
+            {
+                const int Offset = Function->GetOffsetFunc(Member, false);
+                const int End = Offset + static_cast<int>(sizeof(T));
+                if (Offset < 0 || End > static_cast<int>(Bytes.size())) return false;
+                for (const auto& Range : Occupied) if (Offset < Range.second && End > Range.first) return false;
+                if constexpr (std::is_same_v<T, bool>)
+                {
+                    // Native bool parameters only; do not guess packed bool/ByteOffset layout.
+                    if (GetFieldMask(Function->GetPropertyFunc(Member, false)) != 0xFF) return false;
+                }
+                std::memcpy(Bytes.data() + Offset, &Value, sizeof(T));
+                Occupied.emplace_back(Offset, End);
+                if (LogParameters)
+                {
+                    LOG_INFO(LogBots, "[BOT] reflected param {} offset={} bytes={}", Member, Offset, sizeof(T));
+                }
+                return true;
+            }
+
+            template<typename T>
+            bool Return(T& Value)
+            {
+                const int Offset = Function->GetOffsetFunc("ReturnValue", false);
+                if (Offset < 0 || Offset + sizeof(T) > Bytes.size()) return false;
+                std::memcpy(&Value, Bytes.data() + Offset, sizeof(T));
+                return true;
+            }
+
+            void Invoke(UObject* Object) { Object->ProcessEvent(Function, Bytes.data()); }
+        };
+
+        template<typename T>
+        bool Getter(UObject* Object, const wchar_t* FunctionPath, T& Value)
+        {
+            if (!Valid(Object)) return false;
+            auto Fn = FindObject<UFunction>(FunctionPath);
+            if (!Valid(Fn) || !IsOf(Fn->OuterPrivate, L"/Script/CoreUObject.Class")
+                || !Object->IsA(reinterpret_cast<UClass*>(Fn->OuterPrivate))) return false;
+            ReflectedCall Call;
+            if (!Call.Init(Fn, {"ReturnValue"}) || !Call.Put("ReturnValue", T{})) return false;
+            Call.Invoke(Object);
+            return Call.Return(Value);
+        }
