+// Read the entire bool metadata quartet, including ByteOffset. The existing
+// version-aware GetFieldMask helper documents this layout. Only this build is
+// accepted; no bool write or raw UObject bool cast is performed.
+bool PhoebeBit(UObject* Object, const char* Member, bool& Value)
+{
+    Value = false;
+    if (!Valid(Object) || Engine_Version != 426 || std::abs(Fortnite_Version - 13.40) > 0.001) return false;
+    auto Field = Object->GetProperty(Member, false);
+    const int Offset = Object->GetOffset(Member, false);
+    if (!Field || Offset < 0 || Offset > 65536 || IsBadReadPtr(Field, 124)) return false;
+    const auto Size = GetFieldMask(Field, -3);
+    const auto ByteOffset = GetFieldMask(Field, -2);
+    const auto ByteMask = GetFieldMask(Field, -1);
+    const auto Mask = GetFieldMask(Field);
+    if ((Size != 1 && Size != 2 && Size != 4 && Size != 8) || ByteOffset >= Size || !ByteMask
+        || (ByteMask & (ByteMask - 1)) || !Mask
+        || (Mask != 0xff && (Mask != ByteMask || (Mask & (Mask - 1))))) return false;
+    auto Byte = reinterpret_cast<const uint8_t*>(Object) + Offset + ByteOffset;
+    if (IsBadReadPtr(Byte, 1)) return false;
+    Value = (*Byte & Mask) != 0;
+    LOG_INFO(LogBots, "[PHOEBE] {}={} available=true owner={} offset={} byte_offset={} field_size={} byte_mask={} field_mask={}",
+        Member, Value, Object->GetPathName(), Offset, ByteOffset, Size, ByteMask, Mask);
+    return true;
+}
+
+void PhoebeFlags(UObject* Object, std::initializer_list<const char*> Members)
+{
+    for (const char* Member : Members)
+    {
+        bool Value = false;
+        if (!PhoebeBit(Object, Member, Value))
+        {
+            LOG_INFO(LogBots, "[PHOEBE] {}=UNKNOWN available=false owner_valid={}; no flag write", Member, Valid(Object));
+        }
+    }
+}
+
+void PhoebeInitialLock(UObject* World, UObject* Navigation)
+{
+    auto Fn = FindObject<UFunction>(L"/Script/FortniteGame.AthenaNavSystem.IsInitialNavigationLockActive");
+    PhoebeSchema("AthenaNavSystem.IsInitialNavigationLockActive", Fn);
+    ReflectedCall InstanceCall;
+    ReflectedCall StaticCall;
+    bool Value = false, Available = false;
+    const char* Route = "signature/receiver unavailable";
+    if (IsOf(Navigation, L"/Script/FortniteGame.AthenaNavSystem") && Valid(Fn)
+        && Fn->OuterPrivate == FindObject<UClass>(L"/Script/FortniteGame.AthenaNavSystem")
+        && InstanceCall.Init(Fn, {"ReturnValue"}) && InstanceCall.Put("ReturnValue", false))
+    {
+        InstanceCall.Invoke(Navigation);
+        Available = InstanceCall.Return(Value);
+        Route = "exact ReturnValue-only instance getter";
+    }
+    else
+    {
+        auto Receiver = NavStaticReceiver(Fn, L"/Script/FortniteGame.Default__AthenaNavSystem");
+        if (Receiver && StaticCall.Init(Fn, {"WorldContextObject", "ReturnValue"})
+            && StaticCall.Put("WorldContextObject", World) && StaticCall.Put("ReturnValue", false))
+        {
+            StaticCall.Invoke(Receiver);
+            Available = StaticCall.Return(Value);
+            Route = "exact WorldContextObject/ReturnValue getter on existing owner CDO";
+        }
+    }
+    LOG_INFO(LogBots, "[PHOEBE] initial_lock available={} value={} route={}; lock owner/reason bits UNKNOWN; no unlock",
+        Available, Available ? (Value ? "true" : "false") : "UNKNOWN", Route);
+}
+
+void PhoebeNavConfig(UObject* Object, const char* Label)
+{
+    PhoebeObject(Label, Object);
+    if (!Valid(Object)) return;
+    FName Name;
+    const bool HasName = Read(Object, "DefaultAgentName", Name);
+    LOG_INFO(LogBots, "[PHOEBE] {} default_agent_available={} name={}", Label, HasName, HasName ? Name.ToString() : "UNKNOWN");
+    PhoebeFlags(Object, {"bInitialBuildingLocked", "bAutoCreateNavigationData", "bAutoSpawnMissingNavData",
+        "bUsesStreamedInNavLevel", "bAllowAutoRebuild", "bSpawnNavDataInNavBoundsLevel",
+        "bShouldDiscardSubLevelNavData", "bGenerateNavigationOnlyAroundNavigationInvokers",
+        "bUseBuildingGridAsNavigableSpace", "bUseNavigationInvokers", "bCreateOnClient", "bIsOverriden"});
+}
