+void PhoebeStreaming(UObject* World, UObject* Playlist)
+{
+    TArray<TSoftObjectPtr<UObject>> ServerLevels{};
+    const bool HasServer = NavArray(Playlist, "AdditionalLevelsServerOnly", ServerLevels, 64);
+    LOG_INFO(LogBots, "[PHOEBE] playlist AdditionalLevelsServerOnly available={} count={}; borrowed, no load", HasServer, HasServer ? ServerLevels.ArrayNum : -1);
+    if (HasServer)
+        for (int i = 0; i < ServerLevels.ArrayNum; ++i)
+        {
+            LOG_INFO(LogBots, "[PHOEBE] playlist server_level[{}] asset={}", i, ServerLevels.Data[i].SoftObjectPtr.ObjectID.AssetPathName.ToString());
+        }
+    TArray<UObject*> Levels{};
+    const bool HasLevels = NavArray(World, "StreamingLevels", Levels, 1024);
+    LOG_INFO(LogBots, "[PHOEBE] World.StreamingLevels available={} count={}; read-only sample_limit=64", HasLevels, HasLevels ? Levels.ArrayNum : -1);
+    if (!HasLevels) return;
+    for (int i = 0; i < Levels.ArrayNum && i < 64; ++i)
+    {
+        auto Item = Levels.Data[i];
+        if (!IsOf(Item, L"/Script/Engine.LevelStreaming")) continue;
+        FName Package;
+        bool Loaded = false, Visible = false;
+        const bool HasPackage = Getter(Item, L"/Script/Engine.LevelStreaming.GetWorldAssetPackageFName", Package);
+        const bool HasLoaded = Getter(Item, L"/Script/Engine.LevelStreaming.IsLevelLoaded", Loaded);
+        const bool HasVisible = Getter(Item, L"/Script/Engine.LevelStreaming.IsLevelVisible", Visible);
+        LOG_INFO(LogBots, "[PHOEBE] streaming[{}] package={} loaded={} visible={}", i, HasPackage ? Package.ToString() : "UNKNOWN",
+            HasLoaded ? (Loaded ? "true" : "false") : "UNKNOWN", HasVisible ? (Visible ? "true" : "false") : "UNKNOWN");
+    }
+}
