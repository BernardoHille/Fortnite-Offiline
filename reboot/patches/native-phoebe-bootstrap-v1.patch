+bool PhoebeAgentMatches(UObject* Data)
+{
+    auto PawnCDO = FindObject(L"/Game/Athena/AI/Phoebe/BP_PlayerPawn_Athena_Phoebe.Default__BP_PlayerPawn_Athena_Phoebe_C");
+    auto MovementCDO = Reference(PawnCDO, "CharacterMovement");
+    const auto Props = NavStruct(MovementCDO, "NavAgentProps", L"/Script/Engine.NavAgentProperties");
+    const auto Config = NavStruct(Data, "Config", L"/Script/Engine.NavDataConfig");
+    float PawnRadius = 0, PawnHeight = 0, DataRadius = 0, DataHeight = 0;
+    const bool Available = NavRead(Props, "AgentRadius", PawnRadius) && NavRead(Props, "AgentHeight", PawnHeight)
+        && NavRead(Config, "AgentRadius", DataRadius) && NavRead(Config, "AgentHeight", DataHeight);
+    const bool Matches = Available && std::isfinite(PawnRadius) && std::isfinite(PawnHeight)
+        && std::isfinite(DataRadius) && std::isfinite(DataHeight) && PawnRadius > 0 && PawnHeight > 0
+        && std::abs(PawnRadius - DataRadius) < 0.01f && std::abs(PawnHeight - DataHeight) < 0.01f;
+    LOG_INFO(LogBots, "[PHOEBE] Phoebe CDO agent exact_dimensions_match={} values_available={} pawn_radius={} pawn_height={} nav_radius={} nav_height={}; conservative gate, no native agent-selection claim",
+        Matches, Available, PawnRadius, PawnHeight, DataRadius, DataHeight);
+    return Matches;
+}
+
+bool PhoebePath(UObject* World, UObject* Data, const FVector& Start, const FVector& End)
+{
+    auto Fn = FindObject<UFunction>(L"/Script/NavigationSystem.NavigationSystemV1.FindPathToLocationSynchronously");
+    auto Receiver = NavStaticReceiver(Fn, L"/Script/NavigationSystem.Default__NavigationSystemV1");
+    ReflectedCall Call;
+    UObject* Path = nullptr;
+    if (!Receiver || !Call.Init(Fn, {"WorldContextObject", "PathStart", "PathEnd", "PathfindingContext", "FilterClass", "ReturnValue"})
+        || !Call.Put("WorldContextObject", World) || !Call.Put("PathStart", Start) || !Call.Put("PathEnd", End)
+        || !Call.Put("PathfindingContext", Data) || !Call.Put("FilterClass", static_cast<UObject*>(nullptr))
+        || !Call.Put("ReturnValue", Path)) return false;
+    Call.Invoke(Receiver); // One native path query; no movement command or actor creation.
+    bool IsValidPath = false, Partial = true;
+    TArray<FVector> Points{};
+    const bool Usable = Call.Return(Path) && IsOf(Path, L"/Script/NavigationSystem.NavigationPath")
+        && Getter(Path, L"/Script/NavigationSystem.NavigationPath.IsValid", IsValidPath) && IsValidPath
+        && Getter(Path, L"/Script/NavigationSystem.NavigationPath.IsPartial", Partial) && !Partial
+        && NavArray(Path, "PathPoints", Points, 10000) && Points.ArrayNum >= 2;
+    LOG_INFO(LogBots, "[PHOEBE] Phoebe NavData explicit_context path_usable={} partial={} points={}; native query only", Usable, Partial, Points.ArrayNum);
+    return Usable;
+}
